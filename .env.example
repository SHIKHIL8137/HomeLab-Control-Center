# Copy to .env for local overrides. Never commit real values.
# "mock" serves clearly-labelled demo data; "live" never falls back to mock data.
HLCC_MODE=mock
HLCC_HOST=127.0.0.1
HLCC_PORT=8787
# Directory for the SQLite database. Keep it outside disposable containers.
HLCC_DATA_DIR=./data
HLCC_POLL_INTERVAL_MS=15000
HLCC_RETENTION_HOURS=48
# Set true when served over HTTPS (Cloudflare Tunnel / Tailscale Serve).
HLCC_COOKIE_SECURE=false
# Optional: one-time first-run setup token (16+ chars). If unset, a random one is printed to the server log.
# HLCC_SETUP_TOKEN=
# Optional comma-separated extra allowed browser origins, e.g. https://hlcc.example.com
# HLCC_ALLOWED_ORIGINS=
# Optional: path to the built web app to serve from the API (production).
# HLCC_WEB_DIST=./apps/web/dist
HLCC_LOG_LEVEL=info

# --- Live mode (see docs/live-monitoring.md). Everything below is unset by default. ---
# Read-only Docker proxy (apps/docker-proxy). Plain http on an internal network, never the socket itself.
# HLCC_DOCKER_URL=http://docker-proxy:2375
# Disks to measure. Mount EMPTY probe directories, not / or /srv/storage.
# "separate": true means it must be a different filesystem from the first disk, else it is refused.
# HLCC_DISKS=[{"label":"/","path":"/probe/root"},{"label":"/srv/storage","path":"/probe/storage","separate":true}]
# Only set to true if you are certain /proc inside the container is the monitored machine's.
# By default host metrics are refused unless cross-checked against the Docker daemon.
# HLCC_HOST_PROC_ASSERT=false
# Optional Netdata base URL (read-only, no credentials are ever sent).
# HLCC_NETDATA_URL=
HLCC_HEALTH_INTERVAL_MS=60000
HLCC_HEALTH_CONCURRENCY=3

# --- docker compose only ---
# Numeric id of the host's docker group, so the proxy can read the socket. Required by deploy/compose.yaml.
# DOCKER_GID=
# HLCC_DATA_PATH=./data
# HLCC_PROBE_ROOT=./probe/root
# HLCC_PROBE_STORAGE=./probe/storage
