# Copy to .env for local overrides. Never commit real values.
# "mock" serves clearly-labelled demo data; "live" never falls back to mock data.
HLCC_MODE=mock
HLCC_HOST=127.0.0.1
HLCC_PORT=8787
# Directory for the SQLite database. Keep it outside disposable containers.
HLCC_DATA_DIR=./data
HLCC_POLL_INTERVAL_MS=15000
HLCC_RETENTION_HOURS=48
# Set true when served over HTTPS (Cloudflare Tunnel / Tailscale Serve).
HLCC_COOKIE_SECURE=false
# Optional: one-time first-run setup token (16+ chars). If unset, a random one is printed to the server log.
# HLCC_SETUP_TOKEN=
# Optional comma-separated extra allowed browser origins, e.g. https://hlcc.example.com
# HLCC_ALLOWED_ORIGINS=
# Optional: path to the built web app to serve from the API (production).
# HLCC_WEB_DIST=./apps/web/dist
HLCC_LOG_LEVEL=info
